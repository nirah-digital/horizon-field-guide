---
/**
 * "How it looks": the picture of every level, side by side, each standing on
 * a soft patch of ground. Troop levels share one size with the feet on the
 * same spot, so the upgrades line up. Many levels (the Lord's 20) scroll
 * sideways in two rows (1–10 over 11–20) instead of filling the page.
 */
import { art, type Look } from '../lib/game'

interface Props {
  items: Look[]
  kind: 'building' | 'troop'
  heading?: string
  /** Under another section's heading (h3 instead of h2). */
  sub?: boolean
}
const { items, kind, heading = 'How it looks', sub = false } = Astro.props
const H = sub ? 'h3' : 'h2'
const strip = items.length > 10
---

{
  items.length > 0 && (
    <section class="looks-section">
      <H>{heading}</H>
      <ul class:list={['looks', kind, { strip }]} role="list" style={strip ? `--cols: ${Math.ceil(items.length / 2)}` : undefined}>
        {items.map((i) => (
          <li>
            <figure>
              <div class="frame">
                <div class="pic" style={`--ar: ${i.w / i.h}; --w: ${i.w}px; --gx: ${i.gx}; --gy: ${i.gy}`}>
                  <img src={art(i.src)} alt={i.alt} width={i.w} height={i.h} loading="lazy" decoding="async" />
                </div>
              </div>
              <figcaption>{i.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      {strip && <p class="small muted swipe">Scroll sideways for every level.</p>}
    </section>
  )
}

<style>
  .looks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Two rows read left to right (1–10 over 11–20), scrolling sideways. */
  .looks.strip {
    grid-template-columns: repeat(var(--cols), 124px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding-bottom: 6px;
  }
  .looks li {
    scroll-snap-align: start;
    min-width: 0;
  }
  figure {
    margin: 0;
    height: 100%;
    background: #fbf6e8;
    border: 2px solid var(--parchment-3);
    border-radius: 12px;
    padding: 8px 6px 6px;
  }
  .frame {
    container-type: size;
    height: 116px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The picture's own box (so the ground can sit under its footprint / feet). */
  .pic {
    position: relative;
    aspect-ratio: var(--ar);
    width: min(100cqw, calc(100cqh * var(--ar)), var(--w));
  }
  .pic::before {
    content: '';
    position: absolute;
    left: calc(var(--gx) * 100%);
    top: calc(var(--gy) * 100%);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(226, 186, 96, 0.55), rgba(246, 214, 122, 0.28) 62%, transparent);
  }
  .building .pic::before {
    width: 108%;
    aspect-ratio: 1.6;
  }
  .troop .pic::before {
    width: 78%;
    aspect-ratio: 2.4;
  }
  .pic img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  figcaption {
    margin-top: 4px;
    text-align: center;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .swipe {
    margin-top: 4px;
  }
</style>
